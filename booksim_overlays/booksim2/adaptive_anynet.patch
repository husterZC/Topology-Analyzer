+void anynet_min_adaptive( const Router *r, const Flit *f, int in_channel,
+			  OutputSet *outputs, bool inject )
+{
+  outputs->Clear();
+
+  if(inject) {
+    anynet_add_injection_outputs(f, outputs);
+    return;
+  }
+
+  int rID = r->GetID();
+  if(anynet_router_for_node(f->dest) == rID) {
+    anynet_add_escape_output_to_dest(r, f, outputs);
+    return;
+  }
+
+  if(anynet_on_escape_vc(f)) {
+    anynet_add_escape_output_to_dest(r, f, outputs);
+    return;
+  }
+
+  anynet_add_min_adaptive_outputs(r, f, f->dest, 0, outputs);
+}
+
+void anynet_valiant( const Router *r, const Flit *f, int in_channel,
+		     OutputSet *outputs, bool inject )
+{
+  outputs->Clear();
+
+  if(inject) {
+    anynet_add_injection_outputs(f, outputs);
+    return;
+  }
+
+  int rID = r->GetID();
+  if(anynet_router_for_node(f->dest) == rID) {
+    anynet_add_escape_output_to_dest(r, f, outputs);
+    return;
+  }
+
+  if(anynet_on_escape_vc(f)) {
+    anynet_add_escape_output_to_dest(r, f, outputs);
+    return;
+  }
+
+  if(anynet_is_source_router(r, f, in_channel)) {
+    f->ph = 0;
+    f->intm = anynet_intermediate(f->src, f->dest, global_anynet_runtime_seed);
+  }
+
+  if(f->ph == 0 && anynet_router_for_node(f->intm) == rID) {
+    f->ph = 1;
+  }
+
+  int target = (f->ph == 0) ? f->intm : f->dest;
+  if(anynet_router_for_node(target) == rID) {
+    if(target == f->dest) {
+      anynet_add_escape_output_to_dest(r, f, outputs);
+      return;
+    }
+    f->ph = 1;
+    target = f->dest;
+  }
+
+  anynet_add_escape_output_to_dest(r, f, outputs);
+  int phase_vc = anynet_phase_vc(f->ph);
+  if(phase_vc >= 0) {
+    outputs->AddRange(anynet_escape_port(rID, target), phase_vc, phase_vc, 1);
+  }
+}
+
+void anynet_ugal_l( const Router *r, const Flit *f, int in_channel,
+		    OutputSet *outputs, bool inject )
+{
+  outputs->Clear();
+
+  if(inject) {
+    anynet_add_injection_outputs(f, outputs);
+    return;
+  }
+
+  int rID = r->GetID();
+  if(anynet_router_for_node(f->dest) == rID) {
+    anynet_add_escape_output_to_dest(r, f, outputs);
+    return;
+  }
+
+  if(anynet_on_escape_vc(f)) {
+    anynet_add_escape_output_to_dest(r, f, outputs);
+    return;
+  }
+
+  if(anynet_is_source_router(r, f, in_channel)) {
+    int intermediate = anynet_best_intermediate(
+      r, f, max(1, global_anynet_runtime_candidates));
+    int min_port = anynet_best_min_port(r, f->dest);
+    int nonmin_port = anynet_best_min_port(r, intermediate);
+    int min_score = anynet_distance(rID, f->dest) * 1024
+      + max(r->GetUsedCredit(min_port), 0);
+    int nonmin_score = anynet_distance(rID, intermediate) * 1024
+      + max(r->GetUsedCredit(nonmin_port), 0);
+    f->intm = intermediate;
+    f->ph = (min_score <= nonmin_score + global_anynet_runtime_threshold) ? 1 : 0;
+  }
+
+  if(f->ph == 0 && anynet_router_for_node(f->intm) == rID) {
+    f->ph = 2;
+  }
+
+  int target = (f->ph == 0) ? f->intm : f->dest;
+  if(anynet_router_for_node(target) == rID) {
+    if(target == f->dest) {
+      anynet_add_escape_output_to_dest(r, f, outputs);
+      return;
+    }
+    f->ph = 2;
+    target = f->dest;
+  }
+
+  anynet_add_min_adaptive_outputs(r, f, target, f->ph, outputs);
+}
+
+void anynet_par( const Router *r, const Flit *f, int in_channel,
+		 OutputSet *outputs, bool inject )
+{
+  outputs->Clear();
+
+  if(inject) {
+    anynet_add_injection_outputs(f, outputs);
+    return;
+  }
+
+  int rID = r->GetID();
+  if(anynet_router_for_node(f->dest) == rID) {
+    anynet_add_escape_output_to_dest(r, f, outputs);
+    return;
+  }
+
+  if(anynet_on_escape_vc(f)) {
+    anynet_add_escape_output_to_dest(r, f, outputs);
+    return;
+  }
+
+  if(anynet_is_source_router(r, f, in_channel)) {
+    f->intm = anynet_best_intermediate(
+      r, f, max(1, global_anynet_runtime_candidates));
+    f->ph = 0;
+  }
+
+  if(f->ph == 0) {
+    int min_port = anynet_best_min_port(r, f->dest);
+    int nonmin_port = anynet_best_min_port(r, f->intm);
+    int min_score = anynet_distance(rID, f->dest) * 1024
+      + max(r->GetUsedCredit(min_port), 0);
+    int nonmin_score = anynet_distance(rID, f->intm) * 1024
+      + max(r->GetUsedCredit(nonmin_port), 0);
+    if(min_score <= nonmin_score + global_anynet_runtime_threshold) {
+      f->ph = 1;
+    }
+  }
+
+  if(f->ph == 0 && anynet_router_for_node(f->intm) == rID) {
+    f->ph = 3;
+  }
+
+  int target = (f->ph == 0) ? f->intm : f->dest;
+  if(anynet_router_for_node(target) == rID) {
+    if(target == f->dest) {
+      anynet_add_escape_output_to_dest(r, f, outputs);
+      return;
+    }
+    f->ph = 3;
+    target = f->dest;
+  }
+
+  anynet_add_min_adaptive_outputs(r, f, target, f->ph, outputs);
+}
+
+static void anynet_vc_range( const Flit *f, int *vcBegin, int *vcEnd )
+{
+  *vcBegin = 0;
+  *vcEnd = gNumVCs - 1;
+  if ( f->type == Flit::READ_REQUEST ) {
+    *vcBegin = gReadReqBeginVC;
+    *vcEnd = gReadReqEndVC;
+  } else if ( f->type == Flit::WRITE_REQUEST ) {
+    *vcBegin = gWriteReqBeginVC;
+    *vcEnd = gWriteReqEndVC;
+  } else if ( f->type ==  Flit::READ_REPLY ) {
+    *vcBegin = gReadReplyBeginVC;
+    *vcEnd = gReadReplyEndVC;
+  } else if ( f->type ==  Flit::WRITE_REPLY ) {
+    *vcBegin = gWriteReplyBeginVC;
+    *vcEnd = gWriteReplyEndVC;
+  }
+}
+
+static bool anynet_is_source_router( const Router *r, const Flit *f, int in_channel )
+{
+  int rID = r->GetID();
+  return anynet_router_for_node(f->src) == rID && in_channel < anynet_local_count(rID);
+}
+
+static int anynet_local_count( int router )
+{
+  if(global_anynet_local_node_count &&
+     global_anynet_local_node_count->count(router) != 0) {
+    return (*global_anynet_local_node_count)[router];
+  }
+  return 0;
+}
+
+static int anynet_router_for_node( int node )
+{
+  assert(global_node_list && global_node_list->count(node) != 0);
+  return (*global_node_list)[node];
+}
+
+static int anynet_escape_port( int router, int destination )
+{
+  assert(global_routing_table && global_routing_table[router].count(destination) != 0);
+  return global_routing_table[router][destination].first;
+}
+
+static int anynet_escape_vc( int router, int destination )
+{
+  assert(global_routing_table && global_routing_table[router].count(destination) != 0);
+  return global_routing_table[router][destination].second;
+}
+
+static int anynet_distance( int router, int destination )
+{
+  if(global_anynet_distance_table &&
+     global_anynet_distance_table[router].count(destination) != 0) {
+    return global_anynet_distance_table[router][destination];
+  }
+  return numeric_limits<int>::max() / 4;
+}
+
+static int anynet_adaptive_vc_begin( )
+{
+  return min(max(global_anynet_escape_vc_count, 1), gNumVCs);
+}
+
+static int anynet_phase_vc( int phase )
+{
+  int begin = anynet_adaptive_vc_begin();
+  if(begin >= gNumVCs) {
+    return -1;
+  }
+  return min(begin + max(phase, 0), gNumVCs - 1);
+}
+
+static bool anynet_on_escape_vc( const Flit *f )
+{
+  return f->vc >= 0 && f->vc < anynet_adaptive_vc_begin();
+}
+
+static int anynet_hash( int a, int b, int c, int seed )
+{
+  unsigned int value = (unsigned int)(seed + 0x9e3779b9U);
+  value ^= (unsigned int)(a + 0x7f4a7c15U + (value << 6) + (value >> 2));
+  value ^= (unsigned int)(b + 0x94d049bbU + (value << 6) + (value >> 2));
+  value ^= (unsigned int)(c + 0x2545f491U + (value << 6) + (value >> 2));
+  return (int)(value & 0x7fffffffU);
+}
+
+static int anynet_intermediate( int src, int dest, int salt )
+{
+  assert(global_node_list);
+  int node_count = global_node_list->size();
+  if(node_count <= 2) {
+    return dest;
+  }
+  int candidate = anynet_hash(src, dest, salt, global_anynet_runtime_seed) % node_count;
+  for(int attempt = 0; attempt < node_count; attempt++) {
+    int node = (candidate + attempt) % node_count;
+    if(node != src && node != dest) {
+      return node;
+    }
+  }
+  return dest;
+}
+
+static int anynet_best_min_port( const Router *r, int target )
+{
+  int rID = r->GetID();
+  int escape = anynet_escape_port(rID, target);
+  int current_dist = anynet_distance(rID, target);
+  int best_port = escape;
+  int best_score = current_dist * 1024 + max(r->GetUsedCredit(escape), 0);
+
+  if(!global_anynet_router_links ||
+     global_anynet_router_links->count(rID) == 0) {
+    return best_port;
+  }
+
+  for(map<int, pair<int, int> >::iterator iter = (*global_anynet_router_links)[rID].begin();
+      iter != (*global_anynet_router_links)[rID].end();
+      iter++) {
+    int neighbor = iter->first;
+    int port = iter->second.first;
+    int dist = anynet_distance(neighbor, target);
+    if(dist >= current_dist) {
+      continue;
+    }
+    int score = dist * 1024 + max(r->GetUsedCredit(port), 0);
+    if(score < best_score) {
+      best_score = score;
+      best_port = port;
+    }
+  }
+  return best_port;
+}
+
+static int anynet_best_intermediate( const Router *r, const Flit *f, int samples )
+{
+  int best = anynet_intermediate(f->src, f->dest, 0);
+  int best_score = numeric_limits<int>::max() / 4;
+  for(int sample = 0; sample < samples; sample++) {
+    int candidate = anynet_intermediate(f->src, f->dest, sample);
+    int candidate_router = anynet_router_for_node(candidate);
+    int first_dist = anynet_distance(r->GetID(), candidate);
+    int second_dist = anynet_distance(candidate_router, f->dest);
+    int port = anynet_best_min_port(r, candidate);
+    int score = (first_dist + second_dist) * 1024 + max(r->GetUsedCredit(port), 0);
+    if(score < best_score) {
+      best_score = score;
+      best = candidate;
+    }
+  }
+  return best;
+}
+
+static void anynet_add_injection_outputs( const Flit *f, OutputSet *outputs )
+{
+  int vcBegin = 0, vcEnd = gNumVCs - 1;
+  anynet_vc_range(f, &vcBegin, &vcEnd);
+  int adaptive_begin = anynet_adaptive_vc_begin();
+  if(adaptive_begin <= vcEnd) {
+    outputs->AddRange(-1, max(vcBegin, adaptive_begin), vcEnd);
+  } else {
+    outputs->AddRange(-1, vcBegin, vcEnd);
+  }
+}
+
+static void anynet_add_escape_output_to_dest( const Router *r, const Flit *f,
+					     OutputSet *outputs )
+{
+  int rID = r->GetID();
+  int out_port = anynet_escape_port(rID, f->dest);
+  int out_vc = anynet_escape_vc(rID, f->dest);
+  outputs->AddRange(out_port, out_vc, out_vc, 0);
+}
+
+static void anynet_add_min_adaptive_outputs( const Router *r, const Flit *f,
+					     int target, int adaptive_phase,
+					     OutputSet *outputs )
+{
+  anynet_add_escape_output_to_dest(r, f, outputs);
+  int vc = anynet_phase_vc(adaptive_phase);
+  if(vc < 0) {
+    return;
+  }
+
+  int out_port = anynet_best_min_port(r, target);
+  outputs->AddRange(out_port, vc, vc, 1);
+}
+

+void AnyNet::routeDistances(int r_start){
+  int* dist = new int[_size];
+  set<int> rlist;
+  for(int i = 0; i<_size; i++){
+    dist[i] = numeric_limits<int>::max();
+    rlist.insert(i);
+  }
+  dist[r_start] = 0;
+  while(!rlist.empty()){
+    int min_dist = numeric_limits<int>::max();
+    int min_cand = -1;
+    for(set<int>::iterator i = rlist.begin();
+	i!=rlist.end();
+	i++){
+      if(dist[*i]<min_dist){
+	min_dist = dist[*i];
+	min_cand = *i;
+      }
+    }
+    if(min_cand < 0) {
+      break;
+    }
+    rlist.erase(min_cand);
+
+    for(map<int,pair<int,int> >::iterator i = router_list[1][min_cand].begin();
+	i!=router_list[1][min_cand].end();
+	i++){
+      if(dist[min_cand] == numeric_limits<int>::max()) {
+	continue;
+      }
+      int new_dist = dist[min_cand] + i->second.second;
+      if(new_dist < dist[i->first]){
+	dist[i->first] = new_dist;
+      }
+    }
+  }
+
+  for(int router = 0; router < _size; router++){
+    for(map<int, pair<int, int> >::iterator iter = router_list[0][router].begin();
+	iter!=router_list[0][router].end();
+	iter++){
+      routing_distance_table[r_start][iter->first] = dist[router];
+    }
+  }
+  delete [] dist;
+}

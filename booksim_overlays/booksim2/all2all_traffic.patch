+AllToAllTrafficPattern::AllToAllTrafficPattern(int nodes)
+  : TrafficPattern(nodes), _offset(nodes, 0)
+{
+  if(nodes < 2) {
+    cout << "Error: all2all traffic requires at least two nodes." << endl;
+    exit(-1);
+  }
+}
+
+void AllToAllTrafficPattern::reset()
+{
+  for(int source = 0; source < _nodes; ++source) {
+    _offset[source] = 0;
+  }
+}
+
+int AllToAllTrafficPattern::dest(int source)
+{
+  assert((source >= 0) && (source < _nodes));
+  int result = (source + 1 + _offset[source]) % _nodes;
+  _offset[source] = (_offset[source] + 1) % (_nodes - 1);
+  return result;
+}

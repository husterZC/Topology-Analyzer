+
+void AnyNet::readRoutingTableFile(){
+  ifstream route_table;
+  string line;
+  route_table.open(route_table_file.c_str());
+  if(!route_table.is_open()){
+    cout<<"Anynet:can't open route table file "<<route_table_file<<endl;
+    exit(-1);
+  }
+  while(!route_table.eof()){
+    getline(route_table,line);
+    if(line=="" || line[0]=='#'){
+      continue;
+    }
+    istringstream line_stream(line);
+    int router=-1;
+    int dest_node=-1;
+    int port=-1;
+    int vc=0;
+    if(!(line_stream >> router >> dest_node >> port >> vc)){
+      cout<<"Anynet:Incomplete route-table line: "<<line<<endl;
+      assert(false);
+    }
+    if(router < 0 || router >= _size){
+      cout<<"Anynet:Route-table router out of range "<<router<<endl;
+      assert(false);
+    }
+    if(node_list.count(dest_node) == 0){
+      cout<<"Anynet:Route-table destination node unknown "<<dest_node<<endl;
+      assert(false);
+    }
+    if(port < 0 || vc < 0){
+      cout<<"Anynet:Route-table port and vc must be non-negative "<<line<<endl;
+      assert(false);
+    }
+    routing_table[router][dest_node]=pair<int, int>(port, vc);
+  }
+  for(int router = 0; router < _size; router++){
+    for(map<int, int>::iterator node = node_list.begin();
+	node != node_list.end();
+	node++){
+      assert(routing_table[router].count(node->first) != 0);
+    }
+  }
 }
 
 
